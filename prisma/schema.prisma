// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(cuid())
  email                 String     @unique
  password              String
  name                  String
  instagram             String?
  phone                 String?
  market                String?
  ftdsPerMonth          String?
  role                  String     @default("USER")

  affiliateParentId     String?
  affiliateParent       User?      @relation("AffiliateHierarchy", fields: [affiliateParentId], references: [id], onDelete: SetNull)
  affiliateChildren     User[]     @relation("AffiliateHierarchy")

  affiliateLinkSite     String?    @unique

  userHouseData         UserHouseData[]
  snapshots             DailySnapshot[]

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model House {
  id                String     @id @default(cuid())
  name              String     @unique
  logoUrl           String?
  color             String     @default("#3b82f6")

  userHouseData     UserHouseData[]
  dailySnapshots    DailySnapshot[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model UserHouseData {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  houseId           String
  house             House      @relation(fields: [houseId], references: [id], onDelete: Cascade)

  cpa               Decimal
  affiliateLink     String     @unique

  registros         Int        @default(0)
  ftds              Int        @default(0)
  qftds             Int        @default(0)

  cpaEditedOnce     Boolean    @default(false)

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([userId, houseId])
}

model DailySnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  registros Int      @default(0)
  ftds      Int      @default(0)
  qftds     Int      @default(0)
  revenue   Decimal  @db.Decimal(10, 2) @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, houseId, date])
}

model SiteSettings {
  id      String @id @default("singleton")
  logoUrl String @default("/uaffiliatedwide.png")
}
